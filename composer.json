{
    "name": "pixel-penguin/laravel-lekkerflow",
    "description": "Ship Laravel application errors to the LekkerFlow error webhook as a Monolog log channel.",
    "keywords": [
        "laravel",
        "logging",
        "monolog",
        "error-tracking",
        "lekkerflow",
        "webhook"
    ],
    "homepage": "https://github.com/PixelPenguinAI/lekkerflow-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Gerrit Vermeulen",
            "email": "gerrit@pixel-penguin.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "PixelPenguin\\LekkerFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PixelPenguin\\LekkerFlow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PixelPenguin\\LekkerFlow\\LekkerFlowServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
